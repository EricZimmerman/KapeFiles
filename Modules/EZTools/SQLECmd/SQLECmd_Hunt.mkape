Description: 'SQLECmd: process SQLite databases with Hunt mode disabled'
Category: SQLDatabases
Author: Andrew Rathbun
Version: 1.1
Id: 74343dd0-47bf-406d-9173-fb626e38cc50
BinaryUrl: https://download.ericzimmermanstools.com/SQLECmd.zip
ExportFormat: csv
Processors:
    -
        Executable: SQLECmd\SQLECmd.exe
        CommandLine: -d %sourceDirectory% --hunt false --csv %destinationDirectory%
        ExportFormat: csv
    -
        Executable: SQLECmd\SQLECmd.exe
        CommandLine: -d %sourceDirectory% --hunt false --json %destinationDirectory%
        ExportFormat: json

# Documentation
# https://github.com/EricZimmerman/SQLECmd
# https://leanpub.com/eztoolsmanuals
